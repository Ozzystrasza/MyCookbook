      "steps": [
        {
          "description": "Bata todos os ingredientes no liquidificador (exceto farinha, fermento e manteiga)"
        },
        {
          "description": "Adicione a farinha aos poucos (se ficar muito grosso, adicione um pouco de água para ajudar a bater, sem exagerar)"
        },
        {
          "description": "Adicione o fermento por último"
        },
        {
          "description": "Assim que terminar de bater, ligue o forno para pré-aquecer a 180°-205° (depende do forno)"
        },
        {
          "description": "Unte a forma com manteiga e farinha, e despeje toda a massa de maneira uniforme"
        },
        {
          "description": "Asse por 40-45 minutos"
        },
        {
          "description": "Espere esfriar e desenforme"
        }
